# ── Tags ──────────────────────────────────────────────────────────────────────
FRONTEND_TAG=latest
BACKEND_TAG=latest

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost/api
FRONTEND_URL=http://localhost

# ── Database (PostgreSQL + pgvector) ──────────────────────────────────────────
POSTGRES_USER=inkwell
POSTGRES_PASSWORD=changeme_db
POSTGRES_DB=inkwell
DATABASE_URL=postgresql://inkwell:changeme_db@db:5432/inkwell

# ── Cache + Queue (Redis) ──────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
REDIS_URL=redis://:changeme_redis@redis:6379

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_min_32_chars

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Object Storage (MinIO) ────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=inkwell
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=inkwell

# ── AI Providers (free-tier first) ────────────────────────────────────────────
GROQ_API_KEY=                  # https://console.groq.com — free tier
GEMINI_API_KEY=                # https://aistudio.google.com — free tier
COHERE_API_KEY=                # https://dashboard.cohere.com — free trial

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=                # https://resend.com — 3000 emails/month free
