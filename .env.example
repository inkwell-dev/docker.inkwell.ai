# ── Tags ──────────────────────────────────────────────────────────────────────
FRONTEND_TAG=latest
BACKEND_TAG=latest

# ── Host user ─────────────────────────────────────────────────────────────────
# The web/api/worker containers bind-mount the repos and write build output into
# them (.next/, dist/). Running as root makes those root-owned on the host and
# breaks `pnpm build` / `tsc`. Set these to your `id -u` / `id -g`.
DOCKER_UID=1000
DOCKER_GID=1000

# ── Nginx publishing ──────────────────────────────────────────────────────────
# nginx is published on TWO addresses at once.
#
# 1) NGINX_BIND_IP:NGINX_PORT — the named hosts. Bound to 127.0.0.2 rather than
#    127.0.0.1 so it cannot collide with anything already holding port 80 on the
#    usual loopback address (ddev-router, a host nginx, Apache). All of
#    127.0.0.0/8 is loopback on Linux. Requires this line in /etc/hosts:
#      127.0.0.2  frontend.inkwell.ai backend.inkwell.ai storage.inkwell.ai
NGINX_BIND_IP=127.0.0.2
NGINX_PORT=80
#
# 2) 127.0.0.1:NGINX_HOST_PORT — the plain localhost origin. Keep it: Google only
#    accepts http:// OAuth redirect URIs on `localhost`, and the frontend's
#    `pnpm api:codegen` hardcodes http://localhost:8080/api/docs-json.
NGINX_HOST_PORT=8080

# Host port PostgreSQL is published on. 5433, not 5432, to avoid colliding with
# a PostgreSQL already installed on the host.
POSTGRES_HOST_PORT=5433

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
# NEXT_PUBLIC_* values are baked into the browser bundle, so they must be
# addresses the BROWSER can reach — never a container name. A mismatch fails
# every client-side request while pages still serve their server shell: the app
# appears to load but shows no data.
NEXT_PUBLIC_API_URL=http://frontend.inkwell.ai/api
NEXT_PUBLIC_SITE_URL=http://frontend.inkwell.ai
FRONTEND_URL=http://frontend.inkwell.ai
# Server-side only: used by the frontend container's generateMetadata() fetches,
# which run inside Docker and can address the API container directly.
INTERNAL_API_URL=http://api:3000/api
# Extra CORS origins beyond FRONTEND_URL, comma-separated.
CORS_ORIGINS=http://localhost:8080

# ── Database (PostgreSQL + pgvector) ──────────────────────────────────────────
POSTGRES_USER=inkwell
POSTGRES_PASSWORD=changeme_db
POSTGRES_DB=inkwell
DATABASE_URL=postgresql://inkwell:changeme_db@db:5432/inkwell

# ── Cache + Queue (Redis) ──────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
REDIS_URL=redis://:changeme_redis@redis:6379

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_min_32_chars

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered verbatim as an authorized redirect URI in Google Cloud
# Console. Keep it on `localhost` — Google refuses http:// for any other host,
# which is the reason nginx still publishes 127.0.0.1:8080.
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# ── Object Storage (MinIO) ────────────────────────────────────────────────────
# The endpoint the backend presigns upload URLs against. It has to be reachable
# from the BROWSER, because the browser performs the PUT — `minio:9000` resolves
# only inside Docker. Port 80: the request goes through nginx's storage vhost,
# which forwards the Host header untouched (a presigned signature covers it).
MINIO_ENDPOINT=storage.inkwell.ai
MINIO_PORT=80
# Scheme of the presigned URL. false locally, true in production.
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=inkwell
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=inkwell

# ── AI Providers (free-tier first) ────────────────────────────────────────────
# Keep comments on their own line — NEVER trailing a value.
# docker compose does not strip a trailing `# ...`, so
# `GROQ_API_KEY=   # https://console.groq.com` assigns the comment text as the
# key. That is worse than leaving it blank: the text contains an em-dash, which
# is illegal in an HTTP header, so the AI SDK throws inside the Headers
# constructor rather than returning a clean 401 — and every AI request answers
# 200 with an empty body and nothing in the logs.
# https://console.groq.com — free tier
GROQ_API_KEY=
# https://aistudio.google.com — free tier, no payment method required.
# TWO roles: the LLM fallback, and ALL RAG embeddings
# (gemini-embedding-001 at 1536 dimensions, via outputDimensionality).
# Without it the embedding pipeline degrades gracefully — chunks are simply not
# written — so RAG and semantic search go quiet while everything else runs.
GEMINI_API_KEY=
# Optional. Read ONLY by automatic content moderation at publish time: OpenAI's
# /v1/moderations is purpose-built and tried FIRST when this is set, otherwise
# the chain starts at Groq. This is NOT an embedding key — embeddings are
# Gemini's, above.
OPENAI_API_KEY=

# ── Error tracking ────────────────────────────────────────────────────────────
# https://sentry.io — free tier. Optional: with no DSN the SDK initialises and
# no-ops, so leaving this blank is a supported state, not a broken one.
#
# This is the SERVER DSN, read at runtime by the api and worker containers.
#
# The browser has a SEPARATE variable, NEXT_PUBLIC_SENTRY_DSN, which does NOT
# belong in this file: `next build` inlines it into the JavaScript, so a runtime
# value changes nothing the browser executes. Set it as a GitHub repository
# variable alongside the other NEXT_PUBLIC_* build args — see the note at the
# bottom of this file.
SENTRY_DSN=

# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION OVERRIDES (the VPS .env — replace the dev URL block above)
# ══════════════════════════════════════════════════════════════════════════════
#
# Everything above is tuned for local Docker, where the hostnames resolve via
# /etc/hosts to 127.0.0.2. Those dev names are NOT the production domain and must
# stay as they are — the Playwright suite and dev.conf both depend on them.
#
# The production domain is inkwell-ai.me:
#
#   NODE_ENV=production
#   FRONTEND_URL=https://inkwell-ai.me
#   CORS_ORIGINS=
#   INTERNAL_API_URL=http://api:3000/api
#   GOOGLE_CALLBACK_URL=https://inkwell-ai.me/api/auth/google/callback
#   MINIO_ENDPOINT=storage.inkwell-ai.me
#   MINIO_PORT=443
#   MINIO_USE_SSL=true
#
# MINIO_ENDPOINT IS THE SUBDOMAIN, NOT THE APEX.
#
# This block previously read `MINIO_ENDPOINT=inkwell.ai`, which would have broken
# every image upload on the first production deploy. MinIO addresses objects as
# /<bucket>/<key>, and presigned PUT URLs are built directly from this value — so
# on the apex the browser would PUT to https://inkwell-ai.me/inkwell/<key>, where
# nginx's `location /` hands the request to Next.js and the upload comes back as
# 404 HTML. The storage.* vhost exists precisely so that `/` means MinIO; see the
# comment above that server block in .infra/nginx/default.conf.
#
# Reads are unaffected and stay on the apex: UploadsService returns the relative
# /storage/<bucket>/<key>, which nginx proxies same-origin. That is why
# NEXT_PUBLIC_STORAGE_URL below is the apex while MINIO_ENDPOINT is not — the
# read path and the write path genuinely use different hostnames.
#
# CORS_ORIGINS is deliberately EMPTY: FRONTEND_URL alone is the allow-list, and
# the schema default (http://localhost:3847) would otherwise leave a dev-machine
# origin authorized in production.
#
# NEXT_PUBLIC_* DOES NOT BELONG IN THIS FILE IN PRODUCTION.
# `next build` inlines those into the browser bundle, so a runtime value changes
# nothing the browser executes. Set them as GitHub repository variables, which
# frontend.inkwell.ai's ci.yml passes to `docker build --build-arg`:
#
#   NEXT_PUBLIC_API_URL=https://inkwell-ai.me/api
#   NEXT_PUBLIC_SITE_URL=https://inkwell-ai.me
#   NEXT_PUBLIC_STORAGE_URL=https://inkwell-ai.me
#   NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# Changing any of them requires REBUILDING the frontend image, not just
# restarting the container.
#
# Note the pair: SENTRY_DSN (above, runtime, for api + worker) and
# NEXT_PUBLIC_SENTRY_DSN (here, build time, for the browser) are two different
# variables pointing at the same Sentry project. Both are optional.
